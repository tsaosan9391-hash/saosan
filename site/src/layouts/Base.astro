---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { church } from "../data/church";
import seo from "../data/settings/seo.json";

interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description = `${church.name}에 오신 것을 환영합니다. ${church.address}. 주일 성결예배 오전 11시.`,
} = Astro.props;

const pageTitle = title ? `${title} | ${church.name}` : `${church.name}`;

// 소유 확인 코드는 관리자 화면에 meta 태그 통째로 붙여 넣어도 되도록 content 값만 골라냅니다
const verificationCode = (value = "") =>
  (value.match(/content\s*=\s*["']([^"']+)["']/)?.[1] ?? value).trim();
const googleVerification = verificationCode(seo.googleVerification);
const naverVerification = verificationCode(seo.naverVerification);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url.href} />

    <!-- 검색엔진 소유 확인용 코드 -->
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    {naverVerification && <meta name="naver-site-verification" content={naverVerification} />}

    <!-- 폰트 미리 불러오기 (본문 렌더링 지연 방지) -->
    <link
      rel="preload"
      href="/fonts/salvation-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/salvation-bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link rel="icon" href="/images/shield-128.png" type="image/png" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
    <meta name="theme-color" content="#da0e2c" />

    <!-- 공유 미리보기 -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={church.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL("/images/hero-1600.jpg", Astro.site)} />
    <meta property="og:locale" content="ko_KR" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- 검색엔진용 교회 정보 -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Church",
        name: church.name,
        alternateName: church.nameEn,
        // 값이 비어 있는 항목은 JSON.stringify 가 undefined 로 빼 줍니다
        telephone: church.phone || undefined,
        email: church.email || undefined,
        address: {
          "@type": "PostalAddress",
          streetAddress: church.address,
          postalCode: church.zipcode || undefined,
          addressCountry: "KR",
        },
        sameAs: [church.youtube, church.instagram].filter(Boolean),
      })}
    />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-sa-red focus:px-4 focus:py-2 focus:font-bold focus:text-white"
    >
      본문 바로가기
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
