---
import Base from "../layouts/Base.astro";
import { navigation, church } from "../data/church";
---

<Base title="페이지를 찾을 수 없습니다">
  <section class="py-24 md:py-32">
    <div class="mx-auto max-w-3xl px-5 text-center">
      <img
        src="/images/shield-256.png"
        alt=""
        width="80"
        height="90"
        class="mx-auto h-20 w-auto opacity-25"
      />

      <p class="mt-8 text-6xl font-bold text-sa-red">404</p>
      <h1 class="mt-5 text-2xl font-bold sm:text-3xl">
        찾으시는 페이지가 없습니다
      </h1>
      <p class="mt-5 leading-relaxed text-sa-muted">
        주소가 바뀌었거나 잘못 입력되었을 수 있습니다.<br />
        아래에서 원하시는 곳으로 이동해 주세요.
      </p>

      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a
          href="/"
          class="rounded-md bg-sa-red px-7 py-3.5 font-bold text-white transition-colors hover:bg-sa-red-dark"
        >
          첫 화면으로
        </a>
        <a
          href={`tel:${church.phone}`}
          class="rounded-md border-2 border-sa-navy px-7 py-3.5 font-bold text-sa-navy transition-colors hover:bg-sa-navy hover:text-white"
        >
          전화로 문의
        </a>
      </div>

      <nav class="mt-14 border-t border-sa-line pt-8" aria-label="전체 메뉴">
        <ul class="flex flex-wrap justify-center gap-x-7 gap-y-3">
          {
            navigation.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="font-bold text-sa-muted transition-colors hover:text-sa-red"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </section>
</Base>
