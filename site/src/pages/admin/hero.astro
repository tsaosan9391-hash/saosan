---
import { GITHUB_REPO, GITHUB_BRANCH } from "../../../site-url.mjs";

/**
 * 메인 화면 배경 사진 위치 맞추기 도구
 *
 * 관리자 화면(Sveltia CMS)은 사진을 끌어서 위치를 맞추는 기능을 넣을 수
 * 없어서(직접 만든 입력 도구를 지원하지 않습니다), 이 화면을 따로 두었습니다.
 *
 * 로그인 방식은 관리자 화면과 똑같습니다. 이미 워커에 만들어 둔
 * /api/auth · /api/callback 을 그대로 씁니다.
 */
const HERO_PATH = "site/src/data/settings/hero.json";
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>배경 사진 위치 맞추기 · 구세군오산교회</title>
    {/*
      is:global 필수 — 사진 목록은 자바스크립트로 만들어 넣기 때문에
      Astro 가 자동으로 붙이는 범위 표시가 없어, 그냥 두면 아래 모양이
      사진 부분에는 하나도 먹히지 않습니다.
    */}
    <style is:global>
      :root {
        --red: #da0e2c;
        --navy: #1f2a44;
        --ink: #1c1c22;
        --muted: #6b6b76;
        --line: #e3e0dc;
        --surface: #f7f5f2;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        font-family:
          -apple-system, BlinkMacSystemFont, "Malgun Gothic",
          "Apple SD Gothic Neo", sans-serif;
        color: var(--ink);
        background: var(--surface);
        line-height: 1.6;
      }
      header {
        background: var(--navy);
        color: #fff;
        padding: 1.25rem 1.25rem 1.1rem;
      }
      header h1 {
        margin: 0;
        font-size: 1.15rem;
      }
      header p {
        margin: 0.35rem 0 0;
        font-size: 0.85rem;
        color: rgb(255 255 255 / 0.7);
      }
      main {
        max-width: 60rem;
        margin: 0 auto;
        padding: 1.25rem 1.25rem 7rem;
      }
      .card {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 10px;
        padding: 1.1rem 1.15rem;
        margin-bottom: 1.1rem;
      }
      button {
        font: inherit;
        cursor: pointer;
        border-radius: 6px;
        border: 1px solid var(--line);
        background: #fff;
        padding: 0.45rem 0.9rem;
      }
      button:hover {
        border-color: var(--red);
      }
      .primary {
        background: var(--red);
        border-color: var(--red);
        color: #fff;
        font-weight: 700;
      }
      .primary:hover {
        background: #b30b24;
      }
      button:disabled {
        opacity: 0.5;
        cursor: not-allowed;
      }
      .tabs {
        display: flex;
        gap: 0.4rem;
      }
      .tabs button[aria-pressed="true"] {
        background: var(--navy);
        border-color: var(--navy);
        color: #fff;
        font-weight: 700;
      }
      .photo {
        display: grid;
        grid-template-columns: 1fr;
        gap: 0.75rem;
        padding: 1rem 0;
        border-top: 1px solid var(--line);
      }
      .photo:first-of-type {
        border-top: 0;
      }
      .frame {
        position: relative;
        width: 100%;
        overflow: hidden;
        border-radius: 8px;
        background: #d8d4cf;
        cursor: grab;
        touch-action: none;
        user-select: none;
      }
      .frame.dragging {
        cursor: grabbing;
      }
      .frame img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        pointer-events: none;
      }
      /* 실제 화면에서 글씨가 얹히는 위치를 가늠할 수 있게 */
      .frame .scrim {
        position: absolute;
        inset: 0;
        background: linear-gradient(
          100deg,
          rgb(20 26 45 / 0.82) 0%,
          rgb(20 26 45 / 0.55) 42%,
          rgb(20 26 45 / 0.12) 78%
        );
        pointer-events: none;
      }
      .frame .hint {
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        background: rgb(0 0 0 / 0.55);
        color: #fff;
        font-size: 0.8rem;
        padding: 0.35rem 0.7rem;
        border-radius: 999px;
        pointer-events: none;
        transition: opacity 0.2s;
      }
      .frame.touched .hint {
        opacity: 0;
      }
      .meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.6rem;
        font-size: 0.85rem;
        color: var(--muted);
      }
      .meta .name {
        font-weight: 700;
        color: var(--ink);
        word-break: break-all;
      }
      .zoom {
        display: flex;
        align-items: center;
        gap: 0.45rem;
      }
      .zoom input[type="range"] {
        width: 9rem;
        accent-color: var(--red);
      }
      .zoom-value {
        min-width: 3rem;
        font-variant-numeric: tabular-nums;
      }
      .bar {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        background: #fff;
        border-top: 1px solid var(--line);
        padding: 0.8rem 1.25rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }
      .status {
        font-size: 0.85rem;
        color: var(--muted);
      }
      .status.error {
        color: var(--red);
        font-weight: 700;
      }
      .status.ok {
        color: #1a7f45;
        font-weight: 700;
      }
      .hidden {
        display: none !important;
      }
      a {
        color: var(--red);
      }
    </style>
  </head>
  <body>
    <header>
      <h1>메인 화면 배경 사진 위치 맞추기</h1>
      <p>
        사진을 끌어서 보여줄 부분을 정한 뒤, 아래 ‘저장하기’를 누르면 됩니다.
      </p>
    </header>

    <main>
      {/* 로그인 전 */}
      <div class="card" id="login-card">
        <p style="margin-top:0">
          <strong>먼저 관리자 화면에 로그인해 주세요.</strong><br />
          관리자 화면에 로그인해 두면 이 화면도 그대로 열립니다. 따로
          로그인할 필요가 없습니다.
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:.5rem">
          <a
            href="/admin/"
            target="_blank"
            rel="noopener"
            class="primary"
            style="display:inline-block;text-decoration:none;padding:.45rem .9rem;border-radius:6px"
          >
            관리자 화면 열기
          </a>
          <button type="button" id="recheck-btn">로그인했어요 · 다시 확인</button>
        </div>
        <p class="status" id="login-status"></p>

        <details style="margin-top:1rem">
          <summary style="cursor:pointer;font-size:.87rem;color:var(--muted)">
            잘 안 되면 — 토큰 직접 넣기
          </summary>
          <p style="font-size:.87rem;color:var(--muted)">
            GitHub 개인 접근 토큰(repo 권한)을 넣어도 됩니다. 이 화면을 닫으면
            지워집니다.
          </p>
          <div style="display:flex;flex-wrap:wrap;gap:.5rem">
            <input
              type="password"
              id="manual-token"
              placeholder="ghp_ 로 시작하는 토큰"
              style="flex:1;min-width:16rem;padding:.45rem .6rem;border:1px solid var(--line);border-radius:6px;font:inherit"
            />
            <button type="button" id="manual-btn">넣기</button>
          </div>
        </details>
      </div>

      {/* 로그인 후 */}
      <div id="editor" class="hidden">
        <div class="card">
          <div class="meta" style="justify-content:space-between">
            <div>
              <strong>어느 화면 기준으로 볼까요?</strong>
              <div style="font-size:.82rem">
                같은 사진도 PC와 휴대폰에서 잘리는 부분이 다릅니다. 둘 다
                확인해 보세요.
              </div>
            </div>
            <div class="tabs">
              <button type="button" data-ratio="2.02" aria-pressed="true">
                PC 화면
              </button>
              <button type="button" data-ratio="0.71" aria-pressed="false">
                휴대폰 화면
              </button>
            </div>
          </div>
        </div>

        <div class="card" id="photo-list"></div>
      </div>
    </main>

    <div class="bar hidden" id="save-bar">
      <span class="status" id="save-status"></span>
      <div style="display:flex;gap:.5rem">
        <button type="button" id="reload-btn">다시 불러오기</button>
        <button type="button" class="primary" id="save-btn">저장하기</button>
      </div>
    </div>

    <script define:vars={{ GITHUB_REPO, GITHUB_BRANCH, HERO_PATH }}>
      const API = `https://api.github.com/repos/${GITHUB_REPO}/contents/${HERO_PATH}`;
      const TOKEN_KEY = "hero-tool-token";

      let token = sessionStorage.getItem(TOKEN_KEY) || "";
      let sha = "";
      let photos = []; // { src, posX, posY }
      let ratio = 2.02;

      const $ = (id) => document.getElementById(id);

      /* ── 글자 인코딩 (한글 파일명이 있어 그냥 btoa 를 쓰면 깨집니다) ── */
      function toBase64(str) {
        const bytes = new TextEncoder().encode(str);
        let bin = "";
        bytes.forEach((b) => (bin += String.fromCharCode(b)));
        return btoa(bin);
      }
      function fromBase64(b64) {
        const bin = atob(String(b64).replace(/\s/g, ""));
        const bytes = Uint8Array.from(bin, (c) => c.charCodeAt(0));
        return new TextDecoder().decode(bytes);
      }

      function setStatus(el, text, kind, autoHideMs) {
        el.textContent = text;
        el.className = "status" + (kind ? " " + kind : "");
        // 새 메시지가 오면 이전 타이머가 뒤늦게 지우지 않도록 토큰으로 구분합니다
        const token = ((el._statusToken || 0) + 1);
        el._statusToken = token;
        if (autoHideMs) {
          setTimeout(() => {
            if (el._statusToken === token) {
              el.textContent = "";
              el.className = "status";
            }
          }, autoHideMs);
        }
      }

      /* ── 1. 로그인 ────────────────────────────────────────────
       *
       * 관리자 화면(Sveltia CMS)이 로그인할 때 저장해 둔 토큰을 그대로
       * 씁니다. 같은 주소(origin)라서 읽을 수 있고, 덕분에 여기서 다시
       * 로그인할 필요가 없습니다.
       *
       * 저장 위치는 Sveltia CMS 가 쓰는 값입니다. 혹시 이름이 바뀌어
       * 못 찾더라도, 아래 '토큰 직접 넣기'로 계속 쓸 수 있습니다.
       */
      function readCmsToken() {
        const keys = [
          "sveltia-cms.user",
          "decap-cms-user",
          "netlify-cms-user",
        ];
        for (const key of keys) {
          try {
            const raw = localStorage.getItem(key);
            if (!raw) continue;
            const parsed = JSON.parse(raw);
            if (parsed && typeof parsed.token === "string" && parsed.token) {
              return parsed.token;
            }
          } catch {
            // 값이 깨져 있으면 다음 것을 봅니다
          }
        }
        return "";
      }

      function tryCmsLogin(showError) {
        const found = readCmsToken();
        if (!found) {
          if (showError) {
            setStatus(
              $("login-status"),
              "아직 로그인 정보를 찾지 못했습니다. 관리자 화면에서 로그인한 뒤 다시 눌러 주세요.",
              "error",
            );
          }
          return false;
        }
        token = found;
        sessionStorage.setItem(TOKEN_KEY, token);
        load();
        return true;
      }

      $("recheck-btn").addEventListener("click", () => tryCmsLogin(true));

      $("manual-btn").addEventListener("click", () => {
        const value = $("manual-token").value.trim();
        if (!value) {
          setStatus($("login-status"), "토큰을 넣어 주세요.", "error");
          return;
        }
        token = value;
        sessionStorage.setItem(TOKEN_KEY, token);
        $("manual-token").value = "";
        load();
      });

      /* ── 2. 현재 설정 불러오기 ───────────────────────────── */
      async function load() {
        setStatus($("login-status"), "사진 목록을 불러오는 중입니다…");
        try {
          const res = await fetch(`${API}?ref=${GITHUB_BRANCH}`, {
            headers: {
              Authorization: `Bearer ${token}`,
              Accept: "application/vnd.github+json",
            },
            cache: "no-store",
          });
          if (res.status === 401 || res.status === 403) {
            sessionStorage.removeItem(TOKEN_KEY);
            token = "";
            // 다시 로그인할 수 있게 처음 화면으로 되돌립니다
            $("login-card").classList.remove("hidden");
            $("editor").classList.add("hidden");
            $("save-bar").classList.add("hidden");
            setStatus(
              $("login-status"),
              res.status === 401
                ? "로그인이 만료되었습니다. 관리자 화면에서 다시 로그인한 뒤 ‘다시 확인’을 눌러 주세요."
                : "이 저장소를 고칠 권한이 없는 계정입니다.",
              "error",
            );
            return;
          }
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          const data = await res.json();
          sha = data.sha;

          const parsed = JSON.parse(fromBase64(data.content));
          photos = (parsed.photos || []).map(normalize).filter(Boolean);

          $("login-card").classList.add("hidden");
          $("editor").classList.remove("hidden");
          $("save-bar").classList.remove("hidden");
          render();
          setStatus(
            $("save-status"),
            `사진 ${photos.length}장을 불러왔습니다.`,
          );
        } catch (err) {
          setStatus(
            $("login-status"),
            "불러오지 못했습니다: " + err.message,
            "error",
          );
        }
      }

      /** 예전 방식(주소만 / 위·가운데·아래)도 읽어 새 방식으로 맞춥니다 */
      function normalize(p) {
        const legacy = { top: 0, center: 50, bottom: 100 };
        if (typeof p === "string") {
          return p.trim() ? { src: p, posX: 50, posY: 50, zoom: 100 } : null;
        }
        if (p && typeof p === "object" && p.src) {
          if (typeof p.position === "string") {
            return {
              src: p.src,
              posX: 50,
              posY: legacy[p.position] ?? 50,
              zoom: 100,
            };
          }
          const clamp = (v, fallback, min, max) => {
            const x = Number(v);
            return Number.isFinite(x) ? Math.min(max, Math.max(min, x)) : fallback;
          };
          return {
            src: p.src,
            posX: clamp(p.posX, 50, 0, 100),
            posY: clamp(p.posY, 50, 0, 100),
            zoom: clamp(p.zoom, 100, 100, 300),
          };
        }
        return null;
      }

      /* ── 3. 화면 그리기 ──────────────────────────────────── */
      function render() {
        const list = $("photo-list");
        list.textContent = "";

        photos.forEach((photo, i) => {
          const row = document.createElement("div");
          row.className = "photo";

          const frame = document.createElement("div");
          frame.className = "frame";
          frame.style.aspectRatio = String(ratio);
          // 휴대폰 기준일 때는 실제 휴대폰 폭만큼만 보여줍니다
          // (안 그러면 세로로 길쭉하게 화면을 다 차지합니다)
          if (ratio < 1) {
            frame.style.maxWidth = "360px";
            frame.style.margin = "0 auto";
          }

          const img = document.createElement("img");
          img.src = photo.src;
          img.alt = "";
          img.style.objectPosition = `${photo.posX}% ${photo.posY}%`;
          img.addEventListener("error", () => {
            frame.style.background = "#f0d9dc";
            hint.textContent = "사진을 불러올 수 없습니다";
          });

          const scrim = document.createElement("div");
          scrim.className = "scrim";

          const hint = document.createElement("div");
          hint.className = "hint";
          hint.textContent = "끌어서 위치 맞추기";

          frame.append(img, scrim, hint);

          /* 확대 조절 */
          const zoomWrap = document.createElement("label");
          zoomWrap.className = "zoom";
          const zoomText = document.createElement("span");
          zoomText.textContent = "확대";
          const zoomInput = document.createElement("input");
          zoomInput.type = "range";
          zoomInput.min = "100";
          zoomInput.max = "300";
          zoomInput.step = "5";
          zoomInput.value = String(photo.zoom);
          const zoomValue = document.createElement("span");
          zoomValue.className = "zoom-value";
          zoomInput.addEventListener("input", () => {
            photo.zoom = Number(zoomInput.value);
            apply();
          });
          zoomWrap.append(zoomText, zoomInput, zoomValue);

          const meta = document.createElement("div");
          meta.className = "meta";
          const name = document.createElement("span");
          name.className = "name";
          name.textContent = decodeURIComponent(photo.src.split("/").pop());
          const readout = document.createElement("span");
          readout.dataset.readout = "";
          const reset = document.createElement("button");
          reset.type = "button";
          reset.textContent = "되돌리기";
          reset.addEventListener("click", () => {
            photo.posX = 50;
            photo.posY = 50;
            photo.zoom = 100;
            zoomInput.value = "100";
            apply();
          });
          meta.append(name, readout, zoomWrap, reset);

          function apply() {
            img.style.objectPosition = `${photo.posX}% ${photo.posY}%`;
            // 확대해도 고른 지점이 그대로 남도록 기준점을 같은 자리에 둡니다
            img.style.transform = `scale(${photo.zoom / 100})`;
            img.style.transformOrigin = `${photo.posX}% ${photo.posY}%`;
            readout.textContent = `가로 ${Math.round(photo.posX)}% · 세로 ${Math.round(photo.posY)}%`;
            zoomValue.textContent = `${Math.round(photo.zoom)}%`;
            markDirty();
          }
          apply();

          /* 끌어서 위치 맞추기 */
          let startX = 0,
            startY = 0,
            baseX = 50,
            baseY = 50,
            // 화면에서 1px 끌었을 때 위치 값이 얼마나 움직이는지를 나타내는 값.
            // 확대 배율까지 넣어서 계산하므로, 확대한 뒤에도 사진이 손끝을
            // 그대로 따라옵니다.
            denomX = 0,
            denomY = 0;

          frame.addEventListener("pointerdown", (e) => {
            if (!img.naturalWidth) return;
            frame.classList.add("dragging", "touched");
            frame.setPointerCapture(e.pointerId);
            startX = e.clientX;
            startY = e.clientY;
            baseX = photo.posX;
            baseY = photo.posY;

            const r = frame.getBoundingClientRect();
            // 틀을 꽉 채우도록 맞췄을 때의 사진 크기
            const cover = Math.max(
              r.width / img.naturalWidth,
              r.height / img.naturalHeight,
            );
            const coverW = img.naturalWidth * cover;
            const coverH = img.naturalHeight * cover;
            const z = photo.zoom / 100;

            denomX = r.width * (1 - z) - z * (coverW - r.width);
            denomY = r.height * (1 - z) - z * (coverH - r.height);
          });

          frame.addEventListener("pointermove", (e) => {
            if (!frame.classList.contains("dragging")) return;
            const clamp = (v) => Math.min(100, Math.max(0, v));
            // 움직일 여지가 없는 방향(사진이 딱 맞는 경우)은 건너뜁니다
            if (Math.abs(denomX) > 0.5) {
              photo.posX = clamp(baseX + ((e.clientX - startX) / denomX) * 100);
            }
            if (Math.abs(denomY) > 0.5) {
              photo.posY = clamp(baseY + ((e.clientY - startY) / denomY) * 100);
            }
            apply();
          });

          const end = (e) => {
            if (!frame.classList.contains("dragging")) return;
            frame.classList.remove("dragging");
            try {
              frame.releasePointerCapture(e.pointerId);
            } catch {}
          };
          frame.addEventListener("pointerup", end);
          frame.addEventListener("pointercancel", end);

          row.append(frame, meta);
          list.append(row);
        });
      }

      let dirty = false;
      function markDirty() {
        if (!dirty) {
          dirty = true;
          setStatus($("save-status"), "고친 내용이 있습니다. 저장해 주세요.");
        }
      }

      /* 화면 기준(PC/휴대폰) 바꾸기 */
      document.querySelectorAll("[data-ratio]").forEach((btn) => {
        btn.addEventListener("click", () => {
          document
            .querySelectorAll("[data-ratio]")
            .forEach((b) => b.setAttribute("aria-pressed", "false"));
          btn.setAttribute("aria-pressed", "true");
          ratio = Number(btn.dataset.ratio);
          render();
        });
      });

      /* ── 4. 저장 ─────────────────────────────────────────── */
      $("save-btn").addEventListener("click", async () => {
        const btn = $("save-btn");
        btn.disabled = true;
        setStatus($("save-status"), "저장하는 중입니다…");

        const body = {
          photos: photos.map((p) => ({
            src: p.src,
            posX: Math.round(p.posX),
            posY: Math.round(p.posY),
            zoom: Math.round(p.zoom),
          })),
        };

        try {
          const res = await fetch(API, {
            method: "PUT",
            headers: {
              Authorization: `Bearer ${token}`,
              Accept: "application/vnd.github+json",
              "Content-Type": "application/json",
            },
            body: JSON.stringify({
              message: "메인 화면 배경 사진 위치 조정",
              content: toBase64(JSON.stringify(body, null, 2) + "\n"),
              sha,
              branch: GITHUB_BRANCH,
            }),
          });

          if (res.status === 409) {
            setStatus(
              $("save-status"),
              "다른 곳에서 먼저 바뀌었습니다. ‘다시 불러오기’ 후 다시 맞춰 주세요.",
              "error",
            );
            btn.disabled = false;
            return;
          }
          if (!res.ok) throw new Error(`HTTP ${res.status}`);

          const data = await res.json();
          sha = data.content.sha;
          dirty = false;
          setStatus(
            $("save-status"),
            "저장했습니다. 1~2분 뒤 홈페이지에 반영됩니다.",
            "ok",
            10000,
          );
        } catch (err) {
          setStatus(
            $("save-status"),
            "저장하지 못했습니다: " + err.message,
            "error",
          );
        } finally {
          btn.disabled = false;
        }
      });

      $("reload-btn").addEventListener("click", () => {
        dirty = false;
        load();
      });

      /* 저장 안 하고 나가려 할 때 알려줍니다 */
      window.addEventListener("beforeunload", (e) => {
        if (dirty) e.preventDefault();
      });

      // 이미 이 화면에서 쓰던 토큰이 있으면 그걸로, 없으면
      // 관리자 화면에 로그인해 둔 정보를 찾아 바로 시작합니다.
      if (token) {
        load();
      } else {
        tryCmsLogin(false);
      }
    </script>
  </body>
</html>
