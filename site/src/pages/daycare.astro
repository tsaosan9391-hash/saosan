---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { church, daycare } from "../data/church";

const albums = (
  await getCollection("galleries", ({ data }) => data.published && data.daycare)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, "0")}.${String(d.getDate()).padStart(2, "0")}`;

// 소개 글은 빈 줄을 기준으로 문단을 나눠 보여 줍니다
const paragraphs = daycare.intro
  .split(/\n\s*\n/)
  .map((p) => p.trim())
  .filter(Boolean);
---

<Base
  title={daycare.name}
  description={`${church.name} 부설 ${daycare.name} 안내.`}
>
  <section class="py-20 md:py-24">
    <div class="mx-auto max-w-6xl px-5">
      <div class="grid gap-12 lg:grid-cols-2">
        {/* 소개 */}
        <div>
          <p class="eyebrow">{church.name} 부설</p>
          <h1 class="mt-4 text-2xl font-bold sm:text-3xl">{daycare.name}</h1>
          <div class="mt-6">
            {paragraphs.map((p) => (
              <p class="mt-5 text-[1.0625rem] leading-[1.85] text-sa-ink/80 first:mt-0 sm:text-lg">
                {p}
              </p>
            ))}
          </div>
        </div>

        {/* 안내 — 주소·전화가 비어 있으면 그 줄은 숨깁니다 */}
        {(daycare.address || daycare.phone) && (
          <div class="h-fit rounded-xl bg-sa-surface p-9">
            <p class="eyebrow">안내</p>
            <dl class="mt-6 space-y-5">
              {daycare.address && (
                <div>
                  <dt class="text-sm font-bold text-sa-muted">주소</dt>
                  <dd class="mt-1 text-lg">{daycare.address}</dd>
                </div>
              )}
              {daycare.phone && (
                <div>
                  <dt class="text-sm font-bold text-sa-muted">전화</dt>
                  <dd class="mt-1">
                    <a
                      href={`tel:${daycare.phone}`}
                      class="text-lg font-bold text-sa-red hover:underline"
                    >
                      {daycare.phone}
                    </a>
                  </dd>
                </div>
              )}
            </dl>
          </div>
        )}
      </div>

      {/* 샛별어린이집 앨범 (관리자 화면 '사진 갤러리'에서 '샛별어린이집 앨범'을 체크한 것) */}
      {albums.length > 0 && (
        <div class="mt-16 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {albums.map((g) => (
            <a
              href={`/gallery/${g.id}`}
              class="group block overflow-hidden rounded-xl border border-sa-line bg-white transition-shadow hover:shadow-lg"
            >
              <div class="aspect-[4/3] overflow-hidden bg-sa-navy/10">
                <img
                  src={g.data.photos[0]}
                  alt=""
                  loading="lazy"
                  class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                />
              </div>
              <div class="p-5">
                <p class="text-xs font-bold text-sa-muted">{fmt(g.data.date)}</p>
                <h2 class="mt-2 font-bold leading-snug group-hover:text-sa-red">
                  {g.data.title}
                </h2>
                <p class="mt-1.5 text-sm text-sa-muted">사진 {g.data.photos.length}장</p>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</Base>
