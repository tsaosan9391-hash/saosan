---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import {
  church,
  mainServices,
  prayerServices,
  visions,
  intro,
  fullAddress,
  heroPhotos,
  videoDisplay,
} from "../data/church";
import VideoGrid from "../components/VideoGrid.astro";
import PhotoSlideshow from "../components/PhotoSlideshow.astro";
import HeroSlideshow from "../components/HeroSlideshow.astro";
import {
  fetchChannelVideos,
  toVideo,
  mergeVideos,
  type Video,
} from "../lib/youtube";

// 관리자가 직접 등록한 영상 (일부공개 영상 등)
const registered = (await getCollection("videos"))
  .map((entry) => toVideo(entry.data))
  .filter((v): v is Video => v !== null);

// 자동으로 불러온 목록과 합쳐 최신순으로 보여줍니다
const videos = mergeVideos(
  await fetchChannelVideos(church.youtubeChannelId, 15),
  registered,
);

const galleries = (
  await getCollection("galleries", ({ data }) => data.published)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latestGallery = galleries[0];
---

<Base>
  {/* ─── 히어로 ────────────────────────────────────────── */}
  <section class="relative isolate overflow-hidden bg-sa-navy">
    {
      heroPhotos.length > 0 ? (
        <HeroSlideshow photos={heroPhotos} alt={church.name} />
      ) : (
        <picture>
          <source
            media="(min-width: 1024px)"
            srcset="/images/hero-2400.webp"
            type="image/webp"
          />
          <source srcset="/images/hero-1600.webp" type="image/webp" />
          <img
            src="/images/hero-1600.jpg"
            alt={`${church.name} 예배 모습`}
            width="2400"
            height="1350"
            fetchpriority="high"
            class="absolute inset-0 h-full w-full object-cover"
          />
        </picture>
      )
    }

    <!-- 밝은 사진 위에 흰 글씨를 얹기 위한 그라데이션 -->
    <div class="hero-scrim absolute inset-0" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-6xl px-5 py-24 md:py-32 lg:py-40">
      <div class="max-w-2xl">
        <p class="text-sm font-bold tracking-[0.2em] text-sa-gold">
          THE SALVATION ARMY · {church.name}
        </p>
        {/* 슬로건 너비에 버튼 네 칸(두 줄)을 맞춥니다 */}
        <div class="w-fit">
        <h1
          class="mt-5 text-4xl font-bold leading-[1.25] text-white sm:text-5xl lg:text-6xl"
        >
          마음은 하나님께<br />손길은 이웃에게
        </h1>
        {/*
          바로가기 버튼 — 네 개 모두 같은 크기·모양, 두 줄 두 칸.
          w-0 min-w-full: 버튼 줄이 슬로건보다 넓어지지 않고 슬로건 너비를 그대로 따릅니다.
          휴대폰에서는 칸이 좁아 아이콘을 빼고 글자만 보여 줍니다.
          유튜브·인스타그램은 주소가 비어 있으면 숨김
        */}
        <div class="mt-10 grid w-0 min-w-full grid-cols-2 gap-2.5">
          <a href="#worship" class="flex items-center justify-center gap-1.5 whitespace-nowrap rounded-md border px-2 py-2.5 text-[13px] font-bold sm:gap-2 sm:text-sm lg:py-3 lg:text-base text-white transition-colors border-sa-red bg-sa-red shadow-lg hover:border-sa-red-dark hover:bg-sa-red-dark">
            <svg class="hidden shrink-0 sm:block" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="9"></circle>
              <path d="M12 7v5l3 2"></path>
            </svg>
            예배 시간 안내
          </a>
          <a href="/visit" class="flex items-center justify-center gap-1.5 whitespace-nowrap rounded-md border px-2 py-2.5 text-[13px] font-bold sm:gap-2 sm:text-sm lg:py-3 lg:text-base text-white transition-colors border-white/40 bg-white/10 backdrop-blur-sm hover:bg-white/20">
            <svg class="hidden shrink-0 sm:block" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z"></path>
              <circle cx="12" cy="9.5" r="2.5"></circle>
            </svg>
            오시는 길
          </a>
          {church.youtube && (
            <a
              href={church.youtube}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center gap-1.5 whitespace-nowrap rounded-md border px-2 py-2.5 text-[13px] font-bold sm:gap-2 sm:text-sm lg:py-3 lg:text-base text-white transition-colors border-white/40 bg-white/10 backdrop-blur-sm hover:bg-white/20"
            >
              <svg class="hidden shrink-0 sm:block" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.3 3.6-6.3 3.6Z"></path>
              </svg>
              유튜브 채널
            </a>
          )}
          {church.instagram && (
            <a
              href={church.instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center gap-1.5 whitespace-nowrap rounded-md border px-2 py-2.5 text-[13px] font-bold sm:gap-2 sm:text-sm lg:py-3 lg:text-base text-white transition-colors border-white/40 bg-white/10 backdrop-blur-sm hover:bg-white/20"
            >
              <svg class="hidden shrink-0 sm:block" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="2" width="20" height="20" rx="5"></rect>
                <circle cx="12" cy="12" r="4.5"></circle>
                <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"></circle>
              </svg>
              인스타그램
            </a>
          )}
        </div>
        </div>
      </div>
    </div>
  </section>

  {/* ─── 구세군 소개 + 오시는 길 ───────────────────────── */}
  <section class="bg-white py-20 md:py-24">
    <div class="mx-auto max-w-6xl px-5">
      <div class="grid gap-14 lg:grid-cols-2">
        <div>
          <p class="eyebrow">구세군이란</p>
          <h2 class="mt-4 text-2xl font-bold sm:text-3xl">
            1865년 영국 런던에서 시작된 교단입니다
          </h2>
          <p class="mt-6 leading-relaxed text-sa-muted">
            {intro.salvationArmy}
          </p>
          <a
            href="/about"
            class="mt-7 inline-flex items-center gap-2 font-bold text-sa-red hover:underline"
          >
            교회 소개 자세히 보기 <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="rounded-xl bg-sa-surface p-9">
          <p class="eyebrow">오시는 길</p>
          <h2 class="mt-4 text-2xl font-bold">{church.name}</h2>
          <dl class="mt-7 space-y-5">
            <div>
              <dt class="text-sm font-bold text-sa-muted">주소</dt>
              <dd class="mt-1 text-lg">{fullAddress}</dd>
            </div>
            {church.phone && (
              <div>
                <dt class="text-sm font-bold text-sa-muted">대표전화</dt>
                <dd class="mt-1">
                  <a
                    href={`tel:${church.phone}`}
                    class="text-lg font-bold text-sa-red hover:underline"
                  >
                    {church.phone}
                  </a>
                </dd>
              </div>
            )}
            {church.email && (
              <div>
                <dt class="text-sm font-bold text-sa-muted">이메일</dt>
                <dd class="mt-1">
                  <a
                    href={`mailto:${church.email}`}
                    class="text-lg font-bold text-sa-red hover:underline"
                  >
                    {church.email}
                  </a>
                </dd>
              </div>
            )}
          </dl>
          <a
            href="/visit"
            class="mt-8 inline-flex w-full items-center justify-center gap-2 rounded-md bg-sa-red px-6 py-3.5 font-bold text-white transition-colors hover:bg-sa-red-dark"
          >
            지도로 위치 확인하기
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* ─── 핵심 가치 ──────────────────────────────────────────── */}
  {visions.length > 0 && (
  <section class="bg-sa-navy py-20 text-white md:py-24">
    <div class="mx-auto max-w-6xl px-5">
      <h2 class="text-3xl font-bold sm:text-4xl">
        {church.name} <span class="text-sa-gold">{visions.length}가지 핵심 가치</span>
      </h2>

      <ol class="mt-12 grid gap-x-10 gap-y-7 md:grid-cols-2">
        {
          visions.map((v, i) => (
            <li class="flex gap-5 border-b border-white/10 pb-6">
              <span class="shrink-0 text-2xl font-bold text-sa-gold">
                {String(i + 1).padStart(2, "0")}
              </span>
              <div class="pt-0.5">
                <p class="text-xl font-bold">{v.title}</p>
                {v.desc && (
                  <p class="mt-1.5 text-lg leading-relaxed text-white/75">{v.desc}</p>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
  )}

  {/* ─── 예배 시간 ─────────────────────────────────────── */}
  <section id="worship" class="scroll-mt-24 bg-white py-20 md:py-24">
    <div class="mx-auto max-w-6xl px-5">
      <p class="eyebrow">예배 안내</p>

      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          mainServices.map((s) => (
            <div class="rounded-xl border border-sa-line bg-sa-surface p-7 transition-colors hover:border-sa-red">
              <p class="text-sm font-bold text-sa-red">
                {s.day}
                {s.place && <span class="font-medium text-sa-muted"> · {s.place}</span>}
              </p>
              <h3 class="mt-2.5 text-xl font-bold">{s.name}</h3>
              <p class="mt-4 text-2xl font-bold text-sa-navy">{s.time}</p>
            </div>
          ))
        }
      </div>

      {
        prayerServices.length > 0 && (
          <div class="mt-6 flex flex-wrap gap-x-10 gap-y-3 rounded-xl bg-sa-navy px-7 py-5">
            {prayerServices.map((s) => (
              <p class="text-white/85">
                <span class="font-bold text-sa-gold">{s.name}</span>
                <span class="ml-3">{s.time}</span>
              </p>
            ))}
          </div>
        )
      }

      <a
        href="/worship"
        class="mt-8 inline-flex items-center gap-2 font-bold text-sa-red hover:underline"
      >
        전체 예배와 모임 보기
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  {/* ─── 설교 영상 ─────────────────────────────────────── */}
  {
    videoDisplay.homeSermonCount > 0 &&
      videos.some((v) => v.category === "sermon") && (
        <section class="bg-sa-surface py-20 md:py-24">
          <div class="mx-auto max-w-6xl px-5">
            <div class="flex flex-wrap items-end justify-between gap-4">
              <div>
                <p class="eyebrow">말씀</p>
                <h2 class="mt-4 text-3xl font-bold sm:text-4xl">설교 영상</h2>
              </div>
              <a
                href="/sermons"
                class="font-bold text-sa-red hover:underline"
              >
                전체 보기 →
              </a>
            </div>

            <VideoGrid
              videos={videos}
              registered={registered}
              limit={videoDisplay.homeSermonCount}
              filter="sermon"
            />
          </div>
        </section>
      )
  }

  {/* ─── 유튜브 (행사·찬양 영상) ──────────────────────────── */}
  {
    videoDisplay.homeEventCount > 0 &&
      videos.some((v) => v.category === "event") && (
        <section class="bg-white py-20 md:py-24">
          <div class="mx-auto max-w-6xl px-5">
            <div class="flex flex-wrap items-center justify-between gap-4">
              <p class="eyebrow">유튜브</p>
              <a
                href="/sermons"
                class="font-bold text-sa-red hover:underline"
              >
                전체 보기 →
              </a>
            </div>

            <div
              class:list={[
                videoDisplay.homeEventCount === 1 && "mx-auto max-w-xl",
              ]}
            >
              <VideoGrid
                videos={videos}
                registered={registered}
                limit={videoDisplay.homeEventCount}
                filter="event"
                gridClass={
                  videoDisplay.homeEventCount === 1
                    ? "mt-12 grid"
                    : undefined
                }
              />
            </div>
          </div>
        </section>
      )
  }

  {/* ─── 행사 사진 ─────────────────────────────────────── */}
  {
    latestGallery && (
      <section class="py-20 md:py-24">
        <div class="mx-auto max-w-6xl px-5">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <p class="eyebrow">사진</p>
              <h2 class="mt-4 text-3xl font-bold sm:text-4xl">
                {latestGallery.data.title}
              </h2>
            </div>
            <a href="/gallery" class="font-bold text-sa-red hover:underline">
              전체 사진 보기 →
            </a>
          </div>

          <div class="mt-12">
            <PhotoSlideshow photos={latestGallery.data.photos.slice(0, 8)} />
          </div>

          <a
            href={`/gallery/${latestGallery.id}`}
            class="mt-6 inline-flex items-center gap-2 font-bold text-sa-red hover:underline"
          >
            "{latestGallery.data.title}" 앨범 전체 보기
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </section>
    )
  }

  {/* ─── 2026 군국표어 ─────────────────────────────────── */}
  <section class="bg-sa-surface py-20 md:py-24">
    <div class="mx-auto max-w-6xl px-5">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div class="flex justify-center lg:justify-start">
          <picture>
            <source srcset="/images/emblem-900.webp" type="image/webp" />
            <img
              src="/images/emblem-900.png"
              alt="2026 구세군 군국표어 엠블럼 — 삶으로 증언하라 (사도행전 1장 8절)"
              width="900"
              height="540"
              loading="lazy"
              class="w-full max-w-md"
            />
          </picture>
        </div>

        <div>
          <p class="eyebrow">2026 군국표어</p>
          <h2 class="mt-4 text-3xl font-bold sm:text-4xl">삶으로 증언하라</h2>
          <blockquote class="mt-7 border-l-4 border-sa-gold pl-6">
            <p class="text-lg leading-relaxed">
              “오직 성령이 너희에게 임하시면 너희가 권능을 받고 예루살렘과 온
              유대와 사마리아와 땅 끝까지 이르러 내 증인이 되리라”
            </p>
            <cite class="mt-3 block font-bold not-italic text-sa-muted">
              사도행전 1장 8절
            </cite>
          </blockquote>
          <p class="mt-7 leading-relaxed text-sa-muted">
            말로만 전하는 것이 아니라, 살아가는 삶으로 예수 그리스도를 증언하는
            한 해가 되기를 소망합니다.
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>
