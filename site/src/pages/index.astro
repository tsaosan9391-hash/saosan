<script>
  // 구세군 소개 영상: 누르면 썸네일 자리에 유튜브 플레이어를 넣어 바로 재생합니다
  document.querySelectorAll<HTMLElement>("[data-sa-video]").forEach((box) => {
    box.querySelector("button")?.addEventListener("click", () => {
      const id = box.dataset.saVideo;
      box.innerHTML = `<iframe class="h-full w-full" src="https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0" title="구세군 소개 영상" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe>`;
    });
  });
</script>
