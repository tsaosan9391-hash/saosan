---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import {
  church,
  mainServices,
  prayerServices,
  intro,
  fullAddress,
  heroPhotos,
  videoDisplay,
} from "../data/church";
import VideoGrid from "../components/VideoGrid.astro";
import PhotoSlideshow from "../components/PhotoSlideshow.astro";
import HeroSlideshow from "../components/HeroSlideshow.astro";
import {
  fetchChannelVideos,
  extractVideoId,
  toVideo,
  mergeVideos,
  type Video,
} from "../lib/youtube";

// 관리자가 직접 등록한 영상 (일부공개 영상 등)
const registered = (await getCollection("videos"))
  .map((entry) => toVideo(entry.data))
  .filter((v): v is Video => v !== null);

// 자동으로 불러온 목록과 합쳐 최신순으로 보여줍니다
const videos = mergeVideos(
  await fetchChannelVideos(church.youtubeChannelId, 15),
  registered,
);

// '구세군이란' 옆 소개 영상
const saVideos = intro.salvationArmyVideos
  .map((v) => ({ ...v, id: extractVideoId(v.url) }))
  .filter((v): v is { url: string; title?: string; id: string } => !!v.id);

const showSermonSection =
  videoDisplay.homeSermonCount > 0 && videos.some((v) => v.category === "sermon");

const galleries = (
  await getCollection("galleries", ({ data }) => data.published && !data.daycare)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latestGallery = galleries[0];

// 샛별어린이집 최신 앨범 (행사 사진 바로 아래에 같은 모양으로)
const latestDaycare = (
  await getCollection("galleries", ({ data }) => data.published && data.daycare)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0];
---

<Base>
  {/* ─── 히어로 ────────────────────────────────────────── */}
  <section class="relative">
    <div class="relative isolate overflow-hidden bg-sa-navy">
    {
      heroPhotos.length > 0 ? (
        <HeroSlideshow photos={heroPhotos} alt={church.name} />
      ) : (
        <picture>
          <source
            media="(min-width: 1024px)"
            srcset="/images/hero-2400.webp"
            type="image/webp"
          />
          <source srcset="/images/hero-1600.webp" type="image/webp" />
          <img
            src="/images/hero-1600.jpg"
            alt={`${church.name} 예배 모습`}
            width="2400"
            height="1350"
            fetchpriority="high"
            class="absolute inset-0 h-full w-full object-cover"
          />
        </picture>
      )
    }

    <!-- 밝은 사진 위에 흰 글씨를 얹기 위한 그라데이션 -->
    <div class="hero-scrim absolute inset-0" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-6xl px-5 pt-10 pb-[14.75rem] sm:pb-[17.5rem] md:pt-14 md:pb-[18.5rem] lg:pt-16 lg:pb-64">
      <div class="max-w-2xl">
        <p class="text-sm font-bold tracking-[0.2em] text-sa-gold">
          THE SALVATION ARMY · {church.name}
        </p>
        <div class="w-fit">
        <h1
          class="mt-5 text-4xl font-bold leading-[1.25] text-white sm:text-5xl lg:text-6xl"
        >
          마음은 하나님께<br />손길은 이웃에게
        </h1>
        </div>
      </div>
    </div>
    </div>

    <div class="pointer-events-none absolute inset-x-0 bottom-[3.75rem] z-30 px-5 sm:bottom-[4.25rem] lg:bottom-0">
      <div class="pointer-events-auto mx-auto max-w-6xl lg:pb-5">
          {/*
            바로가기: 메인 사진 위에 반투명 칸으로 겹쳐 둡니다.
            컴퓨터(1024px 이상)는 하단 번호 옆(오른쪽), 휴대폰·태블릿은 번호 바로 위.
            예배 시간 → 샛별어린이집 → 오시는 길 → 유튜브 채널 → 인스타그램
            항상 한 줄. 휴대폰은 다섯 칸을 같은 너비·같은 높이로(아이콘 없이 이름만 — 칸 너비에 맞춰 글자 크기를 줄여 한 줄),
            태블릿부터는 아이콘과 글자를 옆으로 나란히 둔 직사각형 버튼으로 보여 줍니다.
            유튜브·인스타그램은 주소가 비어 있으면 숨김
          */}
          <div class="grid auto-cols-fr grid-flow-col gap-1 sm:gap-2.5 lg:flex lg:justify-end lg:gap-3">
            <a href="#worship" class="@container sm:[container-type:normal] flex h-10 min-w-0 flex-col items-center justify-center gap-1.5 whitespace-nowrap rounded-lg border px-0.5 text-center font-bold leading-none tracking-tight transition hover:-translate-y-0.5 sm:h-14 sm:flex-row sm:justify-center sm:gap-2 sm:rounded-md sm:px-3 sm:tracking-normal lg:px-5 border-sa-red bg-sa-red text-white hover:bg-sa-red-dark">
              <svg class="hidden h-5 w-5 shrink-0 sm:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
              <span class="text-[min(0.8125rem,20cqi)] sm:text-sm lg:text-base">예배 시간</span>
            </a>
            <a href="/daycare" class="@container sm:[container-type:normal] flex h-10 min-w-0 flex-col items-center justify-center gap-1.5 whitespace-nowrap rounded-lg border px-0.5 text-center font-bold leading-none tracking-tight transition hover:-translate-y-0.5 sm:h-14 sm:flex-row sm:justify-center sm:gap-2 sm:rounded-md sm:px-3 sm:tracking-normal lg:px-5 border-white/40 bg-white/10 text-white backdrop-blur-sm hover:bg-white/20">
              <svg class="hidden h-5 w-5 shrink-0 sm:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 3 2.6 5.6 6.1.7-4.5 4.2 1.2 6L12 16.6 6.6 19.5l1.2-6L3.3 9.3l6.1-.7Z"></path></svg>
              <span class="text-[min(0.8125rem,20cqi)] sm:text-sm lg:text-base">샛별어린이집</span>
            </a>
            <a href="/visit" class="@container sm:[container-type:normal] flex h-10 min-w-0 flex-col items-center justify-center gap-1.5 whitespace-nowrap rounded-lg border px-0.5 text-center font-bold leading-none tracking-tight transition hover:-translate-y-0.5 sm:h-14 sm:flex-row sm:justify-center sm:gap-2 sm:rounded-md sm:px-3 sm:tracking-normal lg:px-5 border-white/40 bg-white/10 text-white backdrop-blur-sm hover:bg-white/20">
              <svg class="hidden h-5 w-5 shrink-0 sm:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z"></path><circle cx="12" cy="9.5" r="2.5"></circle></svg>
              <span class="text-[min(0.8125rem,20cqi)] sm:text-sm lg:text-base">오시는 길</span>
            </a>
            {church.youtube && (
              <a href={church.youtube} target="_blank" rel="noopener noreferrer" class="@container sm:[container-type:normal] flex h-10 min-w-0 flex-col items-center justify-center gap-1.5 whitespace-nowrap rounded-lg border px-0.5 text-center font-bold leading-none tracking-tight transition hover:-translate-y-0.5 sm:h-14 sm:flex-row sm:justify-center sm:gap-2 sm:rounded-md sm:px-3 sm:tracking-normal lg:px-5 border-white/40 bg-white/10 text-white backdrop-blur-sm hover:bg-white/20">
                <svg class="hidden h-6 w-auto shrink-0 sm:block" viewBox="0 0 28 20" aria-hidden="true">
                        <path fill="#FF0000" d="M27.4 3.1A3.5 3.5 0 0 0 25 .6C22.8 0 14 0 14 0S5.2 0 3 .6A3.5 3.5 0 0 0 .6 3.1C0 5.3 0 10 0 10s0 4.7.6 6.9A3.5 3.5 0 0 0 3 19.4c2.2.6 11 .6 11 .6s8.8 0 11-.6a3.5 3.5 0 0 0 2.4-2.5c.6-2.2.6-6.9.6-6.9s0-4.7-.6-6.9Z"></path>
                        <path fill="#fff" d="M11.2 14.3 18.5 10l-7.3-4.3v8.6Z"></path>
                      </svg>
                <span class="text-[min(0.8125rem,20cqi)] sm:text-sm lg:text-base">유튜브 채널</span>
              </a>
            )}
            {church.instagram && (
              <a href={church.instagram} target="_blank" rel="noopener noreferrer" class="@container sm:[container-type:normal] flex h-10 min-w-0 flex-col items-center justify-center gap-1.5 whitespace-nowrap rounded-lg border px-0.5 text-center font-bold leading-none tracking-tight transition hover:-translate-y-0.5 sm:h-14 sm:flex-row sm:justify-center sm:gap-2 sm:rounded-md sm:px-3 sm:tracking-normal lg:px-5 border-white/40 bg-white/10 text-white backdrop-blur-sm hover:bg-white/20">
                <svg class="hidden h-6 w-6 shrink-0 sm:block" viewBox="0 0 24 24" aria-hidden="true">
                        <defs>
                          <radialGradient id="ig-grad" cx="0.3" cy="1.07" r="1.2">
                            <stop offset="0" stop-color="#FFD776"></stop>
                            <stop offset="0.25" stop-color="#F3A554"></stop>
                            <stop offset="0.5" stop-color="#E1306C"></stop>
                            <stop offset="0.8" stop-color="#C13584"></stop>
                            <stop offset="1" stop-color="#5B51D8"></stop>
                          </radialGradient>
                        </defs>
                        <rect width="24" height="24" rx="6" fill="url(#ig-grad)"></rect>
                        <rect x="5" y="5" width="14" height="14" rx="4" fill="none" stroke="#fff" stroke-width="1.8"></rect>
                        <circle cx="12" cy="12" r="3.3" fill="none" stroke="#fff" stroke-width="1.8"></circle>
                        <circle cx="16.4" cy="7.6" r="1.1" fill="#fff"></circle>
                      </svg>
                <span class="text-[min(0.8125rem,20cqi)] sm:text-sm lg:text-base">인스타그램</span>
              </a>
            )}
          </div>
      </div>
    </div>
  </section>

  {/* ─── 구세군 소개 + 핵심 가치 ───────────────────────── */}
  <section class="bg-white py-20 md:py-24">
    <div class="mx-auto max-w-6xl px-5">
      {/* 두 칸은 같은 모양·같은 높이로 나란히 놓입니다 */}
      <div class="grid gap-8 lg:grid-cols-2">
        <div class="flex flex-col items-start rounded-xl bg-sa-surface p-7 sm:p-9">
          <p class="eyebrow">구세군이란</p>
          {/* 칸 너비에 맞춰 글자 크기를 줄여 어느 화면에서도 한 줄로 보이게 합니다 */}
          <div class="@container w-full">
            <h2 class="mt-4 whitespace-nowrap text-[min(1.875rem,6.1cqi)] font-bold">
              1865년 영국 런던에서 시작된 교단입니다
            </h2>
          </div>
          {/* 빈 줄로 나눈 문단마다 따로 보여 줍니다 (관리자 화면에서 빈 줄로 문단 구분) */}
          <div class="mt-6">
            {intro.salvationArmy
              .split(/\n\s*\n/)
              .map((para) => para.trim())
              .filter(Boolean)
              .map((para) => (
                <p class="mt-5 text-[1.0625rem] leading-[1.85] text-sa-ink/80 first:mt-0 sm:text-lg">
                  {para}
                </p>
              ))}
          </div>
          <a
            href="/about"
            class="mt-7 inline-flex items-center gap-2 font-bold text-sa-red hover:underline"
          >
            교회 소개 자세히 보기 <span aria-hidden="true">→</span>
          </a>
        </div>

        {/*
          오른쪽 칸: 구세군 소개 영상. 누르면 그 자리에서 재생됩니다.
          (영상 주소가 비어 있으면 오시는 길 안내)
        */}
        {saVideos.length > 0 ? (
          <div class="flex flex-col items-start rounded-xl bg-sa-surface p-7 sm:p-9">
            <p class="eyebrow">구세군 이야기</p>
            {/* 영상 아래에 제목. 칸 높이에 맞춰 고르게 벌립니다 */}
            <ul class="mt-6 flex w-full flex-1 flex-col justify-between gap-6">
              {saVideos.map((v) => (
                <li>
                  <div
                    class="aspect-video overflow-hidden rounded-lg bg-black"
                    data-sa-video={v.id}
                  >
                    <button
                      type="button"
                      class="group relative block h-full w-full"
                      aria-label={`영상 재생: ${v.title || "구세군 소개 영상"}`}
                    >
                      <img
                        src={`https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`}
                        alt=""
                        loading="lazy"
                        class="h-full w-full object-cover opacity-90 transition-opacity group-hover:opacity-100"
                      />
                      <span class="absolute inset-0 flex items-center justify-center">
                        <span class="flex h-14 w-14 items-center justify-center rounded-full bg-sa-red text-white shadow-lg transition-transform group-hover:scale-110">
                          <svg class="ml-0.5 h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M8 5v14l11-7z"></path>
                          </svg>
                        </span>
                      </span>
                    </button>
                  </div>
                  <div class="mt-3 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                    {v.title && <p class="text-lg font-bold">{v.title}</p>}
                    <a
                      href={v.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-sm text-sa-muted underline decoration-dotted hover:text-sa-red"
                    >
                      유튜브에서 보기
                    </a>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ) : (
          <div class="rounded-xl bg-sa-surface p-9">
            <p class="eyebrow">오시는 길</p>
            <h2 class="mt-4 text-2xl font-bold">{church.name}</h2>
            <dl class="mt-7 space-y-5">
              <div>
                <dt class="text-sm font-bold text-sa-muted">주소</dt>
                <dd class="mt-1 text-lg">{fullAddress}</dd>
              </div>
              {church.phone && (
                <div>
                  <dt class="text-sm font-bold text-sa-muted">대표전화</dt>
                  <dd class="mt-1">
                    <a
                      href={`tel:${church.phone}`}
                      class="text-lg font-bold text-sa-red hover:underline"
                    >
                      {church.phone}
                    </a>
                  </dd>
                </div>
              )}
              {church.email && (
                <div>
                  <dt class="text-sm font-bold text-sa-muted">이메일</dt>
                  <dd class="mt-1">
                    <a
                      href={`mailto:${church.email}`}
                      class="text-lg font-bold text-sa-red hover:underline"
                    >
                      {church.email}
                    </a>
                  </dd>
                </div>
              )}
            </dl>
            <a
              href="/visit"
              class="mt-8 inline-flex w-full items-center justify-center gap-2 rounded-md bg-sa-red px-6 py-3.5 font-bold text-white transition-colors hover:bg-sa-red-dark"
            >
              지도로 위치 확인하기
            </a>
          </div>
        )}
      </div>
    </div>
  </section>

  {/* ─── 설교 영상 ─────────────────────────────────────── */}
  {
    showSermonSection && (
        <section class="bg-sa-surface py-20 md:py-24">
          <div class="mx-auto max-w-6xl px-5">
            <div class="flex flex-wrap items-end justify-between gap-4">
              <div>
                <p class="eyebrow">말씀</p>
                <h2 class="mt-4 text-3xl font-bold sm:text-4xl">설교 영상</h2>
              </div>
              <a
                href="/sermons"
                class="font-bold text-sa-red hover:underline"
              >
                전체 보기 →
              </a>
            </div>

            <VideoGrid
              videos={videos}
              registered={registered}
              limit={videoDisplay.homeSermonCount}
              filter="sermon"
            />
          </div>
        </section>
      )
  }

  {/* ─── 예배 영상 ─────────────────────────────────────── */}
  {/* 바로 위가 같은 흰 바탕(구세군 소개)이면 위 여백을 줄여 간격이 벌어지지 않게 합니다 */}
  {
    videoDisplay.homeEventCount > 0 &&
      videos.some((v) => v.category === "event") && (
        <section
          class:list={[
            "bg-white pb-10 md:pb-12",
            showSermonSection ? "pt-20 md:pt-24" : "pt-0",
          ]}
        >
          <div class="mx-auto max-w-6xl px-5">
            <div class="flex flex-wrap items-center justify-between gap-4">
              <p class="eyebrow">예배 영상</p>
              <a
                href="/sermons"
                class="font-bold text-sa-red hover:underline"
              >
                전체 보기 →
              </a>
            </div>

            <div
              class:list={[
                videoDisplay.homeEventCount === 1 && "mx-auto max-w-xl",
              ]}
            >
              <VideoGrid
                videos={videos}
                registered={registered}
                limit={videoDisplay.homeEventCount}
                filter="event"
                gridClass={
                  videoDisplay.homeEventCount === 1
                    ? "mt-8 grid"
                    : undefined
                }
              />
            </div>
          </div>
        </section>
      )
  }

  {/* ─── 스케치 영상 (관리자 화면 '스케치 영상'에 넣은 것) ──────── */}
  {
    videos.some((v) => v.category === "sketch") && (
      <section class="bg-white py-10 md:py-12">
        <div class="mx-auto max-w-6xl px-5">
          <div class="flex flex-wrap items-center justify-between gap-4">
            <p class="eyebrow">스케치</p>
            <a href="/sermons" class="font-bold text-sa-red hover:underline">
              전체 보기 →
            </a>
          </div>
          <VideoGrid videos={videos} registered={registered} limit={3} filter="sketch" />
        </div>
      </section>
    )
  }

  {/* ─── 행사 사진 ─────────────────────────────────────── */}
  {
    latestGallery && (
      <section class="py-10 md:py-12">
        <div class="mx-auto max-w-6xl px-5">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <p class="eyebrow">사진</p>
              <h2 class="mt-4 text-3xl font-bold sm:text-4xl">
                {latestGallery.data.title}
              </h2>
            </div>
            <a href="/gallery" class="font-bold text-sa-red hover:underline">
              전체 사진 보기 →
            </a>
          </div>

          <div class="mt-8">
            <PhotoSlideshow photos={latestGallery.data.photos.slice(0, 8)} />
          </div>

          <a
            href={`/gallery/${latestGallery.id}`}
            class="mt-6 inline-flex items-center gap-2 font-bold text-sa-red hover:underline"
          >
            "{latestGallery.data.title}" 앨범 전체 보기
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </section>
    )
  }

  {/* ─── 샛별어린이집 사진 ──────────────────────────────── */}
  {
    latestDaycare && (
      <section class="pt-10 pb-20 md:pt-12 md:pb-24">
        <div class="mx-auto max-w-6xl px-5">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <p class="eyebrow">샛별어린이집</p>
              <h2 class="mt-4 text-3xl font-bold sm:text-4xl">
                {latestDaycare.data.title}
              </h2>
            </div>
            <a href="/daycare" class="font-bold text-sa-red hover:underline">
              샛별어린이집 보기 →
            </a>
          </div>

          <div class="mt-8">
            <PhotoSlideshow photos={latestDaycare.data.photos.slice(0, 8)} />
          </div>

          <a
            href={`/gallery/${latestDaycare.id}`}
            class="mt-6 inline-flex items-center gap-2 font-bold text-sa-red hover:underline"
          >
            "{latestDaycare.data.title}" 앨범 전체 보기
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </section>
    )
  }

  {/* ─── 2026 군국표어 ─────────────────────────────────── */}
  <section class="bg-sa-surface py-20 md:py-24">
    <div class="mx-auto max-w-6xl px-5">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div class="flex justify-center lg:justify-start">
          <picture>
            <source srcset="/images/emblem-900.webp" type="image/webp" />
            <img
              src="/images/emblem-900.png"
              alt="2026 구세군 군국표어 엠블럼 — 삶으로 증언하라 (사도행전 1장 8절)"
              width="900"
              height="540"
              loading="lazy"
              class="w-full max-w-md"
            />
          </picture>
        </div>

        <div>
          <p class="eyebrow">2026 군국표어</p>
          <h2 class="mt-4 text-3xl font-bold sm:text-4xl">삶으로 증언하라</h2>
          <blockquote class="mt-7 border-l-4 border-sa-gold pl-6">
            <p class="text-lg leading-relaxed">
