---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import { church, ministries } from "../data/church";

// 지역을 섬긴 활동 앨범 — 공개로 설정한 것만, 최근 순으로
const serviceAlbums = (
  await getCollection("galleries", ({ data }) => data.published && data.service)
)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const fmt = (d: Date) => `${d.getFullYear()}년 ${d.getMonth() + 1}월`;
---

<Base
  title="사역"
  description={`${church.name}의 사역 — ${ministries.map((m) => m.title).join(", ")}.`}
>
  <PageHeader
    eyebrow="사역"
    title="함께 섬기고 있습니다"
    description="예배로 모이고, 삶으로 흩어져 이웃을 섬깁니다."
  />

  {/* ─── 사역 목록 ──────────────────────────────────── */}
  <section class="py-20 md:py-24">
    <div class="mx-auto max-w-6xl px-5">
      <div class="grid gap-7 sm:grid-cols-2 lg:grid-cols-3">
        {
          ministries.map((m) => (
            <div class="group relative overflow-hidden rounded-xl border border-sa-line p-8 transition-colors hover:border-sa-red">
              {m.photo && (
                <>
                  {/* 마우스를 올리면 은은하게 나타나는 배경 사진 */}
                  <img
                    src={m.photo}
                    alt=""
                    aria-hidden="true"
                    loading="lazy"
                    class="absolute inset-0 h-full w-full scale-105 object-cover opacity-0 transition-all duration-500 group-hover:scale-100 group-hover:opacity-100"
                  />
                  <div
                    aria-hidden="true"
                    class="absolute inset-0 bg-sa-navy/0 transition-colors duration-500 group-hover:bg-sa-navy/75"
                  />
                </>
              )}
              <div class="relative z-10">
                <h2
                  class:list={[
                    "text-xl font-bold transition-colors duration-500",
                    m.photo && "group-hover:text-white",
                  ]}
                >
                  {m.title}
                </h2>
                <p
                  class:list={[
                    "mt-3.5 leading-relaxed text-sa-muted transition-colors duration-500",
                    m.photo && "group-hover:text-white/90",
                  ]}
                >
                  {m.desc}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ─── 섬김의 현장 ────────────────────────────────── */}
  {
    serviceAlbums.length > 0 && (
      <section class="bg-sa-surface py-20 md:py-24">
        <div class="mx-auto max-w-6xl px-5">
          <p class="eyebrow">섬김의 현장</p>
          <h2 class="mt-4 text-2xl font-bold sm:text-3xl">
            손길은 이웃에게
          </h2>
          <p class="mt-3 max-w-2xl text-sa-muted">
            교회가 지역에서 이웃과 함께한 시간들입니다.
          </p>

          <div class="mt-12 grid gap-7 sm:grid-cols-2 lg:grid-cols-3">
            {serviceAlbums.map((album) => (
              <a
                href={`/gallery/${album.id}`}
                class="group overflow-hidden rounded-xl border border-sa-line bg-white transition-shadow hover:shadow-lg"
              >
                <div class="aspect-[4/3] overflow-hidden bg-sa-navy/10">
                  <img
                    src={album.data.photos[0]}
                    alt=""
                    loading="lazy"
                    class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                  />
                </div>
                <div class="p-5">
                  <p class="text-xs font-bold text-sa-muted">
                    {fmt(album.data.date)}
                  </p>
                  <h3 class="mt-2 font-bold leading-snug transition-colors group-hover:text-sa-red">
                    {album.data.title}
                  </h3>
                </div>
              </a>
            ))}
          </div>

          <a
            href="/gallery"
            class="mt-8 inline-flex items-center gap-2 font-bold text-sa-red hover:underline"
          >
            사진 더 보기 <span aria-hidden="true">→</span>
          </a>
        </div>
      </section>
    )
  }

  {/* ─── 문의 ───────────────────────────────────────── */}
  <section class="bg-sa-navy py-16 text-white">
    <div
      class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-6 px-5"
    >
      <div>
        <h2 class="text-xl font-bold">사역에 함께하고 싶으신가요?</h2>
        <p class="mt-2 text-white/70">
          어느 사역이든 문을 열어두고 있습니다. 편하게 문의해 주세요.
        </p>
      </div>
      <a
        href={`tel:${church.phone}`}
        class="rounded-md bg-sa-red px-7 py-3.5 font-bold text-white transition-colors hover:bg-sa-red-dark"
      >
        전화로 문의
      </a>
    </div>
  </section>
</Base>
