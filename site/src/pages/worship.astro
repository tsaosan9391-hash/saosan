---
import Base from "../layouts/Base.astro";
import {
  church,
  mainServices,
  prayerServices,
  groups,
  worshipPhotos,
  worshipWatermark,
} from "../data/church";

/** 각 예배가 어떤 시간인지 짧은 설명 */
const serviceNotes: Record<string, string> = {
  "주일 성결예배": "한 주를 여는 대표 예배입니다. 홀리니스 찬양팀이 함께 예배를 세웁니다.",
  "주일 오후예배": "말씀을 조금 더 깊이 나누는 시간입니다.",
  "수요예배": "주중에 말씀으로 다시 힘을 얻는 시간입니다.",
  "금요기도회": "한 주간의 짐을 내려놓고 함께 기도하는 시간입니다.",
};

const firstVisit = [
  {
    q: "무엇을 준비해 가야 하나요?",
    a: "아무것도 준비하지 않으셔도 됩니다. 성경과 찬송은 교회에 준비되어 있습니다.",
  },
  {
    q: "옷차림은 어떻게 하나요?",
    a: "편한 복장으로 오시면 됩니다. 격식을 갖추실 필요 없습니다.",
  },
  {
    q: "헌금을 꼭 해야 하나요?",
    a: "전혀 그렇지 않습니다. 처음 오신 분은 편하게 예배만 드리셔도 됩니다.",
  },
  {
    q: "아이와 함께 가도 되나요?",
    a: "물론입니다. 온 세대 예배처럼 아이와 어른이 함께 드리는 예배도 있습니다. 편하게 함께 오세요.",
  },
];
---

<Base
  title="예배와 모임"
  description={`${church.name} 예배 시간 안내 — ${mainServices.map((s) => `${s.name} ${s.time}`).join(", ")}.`}
>
  {/*
    사진을 배너처럼 딱 잘라 보여주지 않고, 머리글부터 예배 시간
    카드까지 옅게 배어 나오다가 자연스럽게 사라지는 워터마크로 씁니다.
  */}
  <div class="relative isolate overflow-hidden">
    {
      worshipPhotos[0] && (
        <img
          src={worshipPhotos[0]}
          alt=""
          aria-hidden="true"
          class="watermark-fade absolute inset-0 h-full w-full object-cover grayscale"
          style={`opacity: ${worshipWatermark.opacity / 100}; object-position: ${worshipWatermark.posX}% ${worshipWatermark.posY}%`}
        />
      )
    }

    <div
      class:list={[
        "relative border-b border-sa-line",
        !worshipPhotos[0] && "bg-sa-surface",
      ]}
    >
      <div class="mx-auto max-w-6xl px-5 py-16 md:py-20">
        <p class="eyebrow">예배와 모임</p>
        <h1 class="mt-4 text-3xl font-bold sm:text-4xl lg:text-5xl">
          함께 모여 예배드립니다
        </h1>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-sa-muted">
          처음 오시는 분도 편하게 참석하실 수 있습니다. 준비하실 것은 없습니다.
        </p>
      </div>
    </div>

    {/* ─── 주요 예배 ──────────────────────────────────── */}
    <section class="relative py-20 md:py-24">
      <div class="mx-auto max-w-6xl px-5">
        <p class="eyebrow">주요 예배</p>
        <h2 class="mt-4 text-2xl font-bold sm:text-3xl">예배 시간</h2>

        <div class="mt-12 grid gap-6 md:grid-cols-2">
          {
            mainServices.map((s) => (
              <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-3 rounded-xl border border-sa-line bg-white/80 p-8 backdrop-blur-sm">
                <div>
                  <p class="text-sm font-bold text-sa-red">{s.day}</p>
                  <h3 class="mt-2 text-xl font-bold">{s.name}</h3>
                  <p class="mt-3 max-w-sm leading-relaxed text-sa-muted">
                    {serviceNotes[s.name]}
                  </p>
                </div>
                <p class="text-2xl font-bold text-sa-navy">{s.time}</p>
              </div>
            ))
          }
        </div>

        {prayerServices.length > 0 && (
        <div class="mt-6 grid gap-6 md:grid-cols-2">
          {
            prayerServices.map((s) => (
              <div class="flex items-center justify-between gap-4 rounded-xl bg-sa-navy px-8 py-6">
                <h3 class="font-bold text-sa-gold">{s.name}</h3>
                <p class="font-bold text-white">{s.time}</p>
              </div>
            ))
          }
        </div>
        )}
      </div>
    </section>
  </div>

  {/* ─── 교회학교와 모임 ────────────────────────────── */}
  {groups.length > 0 && (
  <section class="bg-sa-surface py-20 md:py-24">
    <div class="mx-auto max-w-6xl px-5">
      <p class="eyebrow">교회학교와 모임</p>
      <h2 class="mt-4 text-2xl font-bold sm:text-3xl">
        각 세대와 각 모임의 시간
      </h2>

      {/*
        표 대신 정의 목록을 씁니다.
        좁은 화면에서 표는 옆으로 밀어야 보이는데, 여기서는 아래로 접혀 그대로 읽힙니다.

        사진/영상은 각 줄 안이 아니라 목록 전체를 덮는 배경으로 깔아 둡니다.
        어느 줄에 마우스를 올리든 그 줄의 사진이 목록 전체 뒤에서 나타나고,
        글씨는 전부 흰색으로, 지금 보고 있는 줄의 제목만 금색으로 강조됩니다.
      */}
      <div class="relative -mx-4 mt-12 overflow-hidden px-4" id="groups-wrap">
        {
          groups.map(
            (g, i) =>
              (g.photo || g.video) &&
              (g.video ? (
                <video
                  src={g.video}
                  muted
                  loop
                  playsinline
                  preload="none"
                  data-media-index={i}
                  class="hover-media pointer-events-none absolute inset-0 h-full w-full scale-105 object-cover opacity-0 transition-all duration-500"
                />
              ) : (
                <img
                  src={g.photo}
                  alt=""
                  aria-hidden="true"
                  loading="lazy"
                  data-media-index={i}
                  class="hover-media pointer-events-none absolute inset-0 h-full w-full scale-105 object-cover opacity-0 transition-all duration-500"
                />
              )),
          )
        }
        <div
          id="groups-overlay"
          aria-hidden="true"
          class="pointer-events-none absolute inset-0 bg-sa-navy/0 transition-colors duration-500"
        />

        <dl class="relative border-t-2 border-sa-navy">
          {
            groups.map((g, i) => (
              <div
                class="relative flex flex-col gap-1 border-b border-sa-line py-4 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6 sm:py-5"
                data-row-index={i}
                data-has-media={g.photo || g.video ? "" : undefined}
              >
                <dt class="group-row-text relative z-10 font-bold transition-colors duration-500">
                  {g.name}
                </dt>
                <dd class="group-row-text relative z-10 text-sa-muted transition-colors duration-500 sm:text-right">
                  {g.time}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>
  )}

  <script>
    // 어느 줄에 마우스를 올리든, 그 줄의 사진/영상이 목록 전체를 덮는
    // 배경으로 나타납니다. 영상은 마우스를 올렸을 때만 내려받고
    // 재생합니다(preload="none") — 계속 재생해 두면 화면에 안 보여도
    // 데이터를 계속 쓰게 됩니다.
    const groupsWrap = document.getElementById("groups-wrap");
    const groupsOverlay = document.getElementById("groups-overlay");

    if (groupsWrap && groupsOverlay) {
      const rows = groupsWrap.querySelectorAll<HTMLElement>("[data-row-index]");

      const clearActive = () => {
        groupsOverlay.classList.add("bg-sa-navy/0");
        groupsOverlay.classList.remove("bg-sa-navy/75");
        rows.forEach((r) => {
          r.querySelectorAll<HTMLElement>(".group-row-text").forEach((t) => {
            t.classList.remove("text-white", "text-sa-gold");
          });
        });
      };

      rows.forEach((row) => {
        if (row.dataset.hasMedia === undefined) return;
        const media = groupsWrap.querySelector<HTMLElement>(
          `[data-media-index="${row.dataset.rowIndex}"]`,
        );
        if (!media) return;

        row.addEventListener("mouseenter", () => {
          groupsOverlay.classList.remove("bg-sa-navy/0");
          groupsOverlay.classList.add("bg-sa-navy/75");
          media.classList.remove("opacity-0", "scale-105");
          media.classList.add("opacity-100", "scale-100");
          if (media instanceof HTMLVideoElement) media.play().catch(() => {});

          rows.forEach((r) => {
            r.querySelectorAll<HTMLElement>(".group-row-text").forEach((t) => {
              t.classList.add("text-white");
            });
          });
          const activeTitle = row.querySelector<HTMLElement>("dt.group-row-text");
          if (activeTitle) {
            activeTitle.classList.remove("text-white");
            activeTitle.classList.add("text-sa-gold");
          }
        });

        row.addEventListener("mouseleave", () => {
          media.classList.add("opacity-0", "scale-105");
          media.classList.remove("opacity-100", "scale-100");
          if (media instanceof HTMLVideoElement) {
            media.pause();
            media.currentTime = 0;
          }
          clearActive();
        });
      });
    }
  </script>

  {/* ─── 예배 풍경 ──────────────────────────────────── */}
  {/* 첫 번째 사진은 위 머리글 배경으로 이미 쓰였으니 여기서는 나머지만 보여줍니다 */}
  {
    worshipPhotos.slice(1).length > 0 && (
      <section class="py-20 md:py-24">
        <div class="mx-auto max-w-6xl px-5">
          <p class="eyebrow">예배 풍경</p>
          <h2 class="mt-4 text-2xl font-bold sm:text-3xl">함께 드리는 예배 모습</h2>

          <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {worshipPhotos.slice(1).map((src) => (
              <img
                src={src}
                alt=""
                class="aspect-[4/3] w-full rounded-xl object-cover"
                loading="lazy"
              />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {/* ─── 처음 오시는 분께 ───────────────────────────── */}
  <section class="py-20 md:py-24">
    <div class="mx-auto max-w-6xl px-5">
      <p class="eyebrow">처음 오시는 분께</p>
      <h2 class="mt-4 text-2xl font-bold sm:text-3xl">자주 묻는 질문</h2>

      <dl class="mt-12 grid gap-x-12 gap-y-9 md:grid-cols-2">
        {
          firstVisit.map((f) => (
            <div>
              <dt class="flex gap-3 font-bold">
                <span class="text-sa-red">Q</span>
                {f.q}
              </dt>
              <dd class="mt-2.5 flex gap-3 leading-relaxed text-sa-muted">
                <span class="font-bold text-sa-navy">A</span>
                {f.a}
              </dd>
            </div>
          ))
        }
      </dl>

      <div class="mt-14 rounded-xl bg-sa-red-soft p-9">
        <h3 class="text-xl font-bold">방문 전에 궁금한 점이 있으신가요?</h3>
        <p class="mt-3 text-sa-muted">
          편하게 교회로 연락 주세요. 어떤 질문이든 괜찮습니다.
        </p>
        <a
          href={`tel:${church.phone}`}
          class="mt-6 inline-flex items-center gap-2 rounded-md bg-sa-red px-7 py-3.5 font-bold text-white transition-colors hover:bg-sa-red-dark"
        >
          {church.phone}
        </a>
      </div>
    </div>
  </section>
</Base>
